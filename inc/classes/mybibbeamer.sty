\definecolor{mnrgreen}{HTML}{009640} % #009640
\setbeamercolor{frametitle}{fg=mnrgreen, bg=black}
\setbeamercolor{background canvas}{bg=black}
\setbeamercolor{normal text}{bg=black, fg=white}
\setbeamercolor{title}{bg=black, fg=mnrgreen}
\setbeamercolor{footer}{bg=mnrgreen, fg=white}

\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamercolor{block title}{fg=mnrgreen,bg=mnrgreen!5}
\setbeamercolor{block body}{fg=black,bg=mnrgreen!50}
\setbeamerfont{block body}{size=\large}
\setbeamerfont{block title}{size=\Large}

\setbeamercolor{enumerate item}{fg=mnrgreen}
\setbeamercolor{item}{fg=mnrgreen}
\setbeamerfont{itemize/enumerate body}{size=\Large}

\setbeamerfont{title}{size=\Huge,series=\bfseries}

\setbeamertemplate{enumerate item}{
    \tikz[baseline=(n.base)]{
        \node[
            circle,
            draw=mnrgreen,
            fill=black,
            text=mnrgreen,
            inner sep=2pt,
            font=\bfseries
            ](n){\theenumi};
        ]
    }
}

\setbeamertemplate{itemize item}{%
  \tikz[baseline=(n.base)]{
    \shade[
    shading=radial,
    inner color=mnrgreen!30,
    outer color=mnrgreen
    ](0,0) circle (8pt);
  }
}

\setbeamertemplate{frametitle}{%
  \begin{beamercolorbox}[
      wd=\paperwidth,
      sep=0.1cm,
  ]{frametitle}
    
      \hbox to \paperwidth{%
        \hspace{0.3cm}%
        \includegraphics[height=.7cm]{mnr-green.png}%
        \hfill
      }
      \vspace{-0.7cm}
      \centering 
      \textbf{\insertframetitle}
  \end{beamercolorbox}

  % --- Linie über die ganze Breite des Titelblocks ---
  \begin{tikzpicture}[overlay, yshift=.6cm]
    \draw[mnrgreen, line width=1pt]
      (-1.0cm,0) -- (\paperwidth,0);
  \end{tikzpicture}

  \vspace*{.2cm}
}

\setbeamertemplate{footline}{
    {\color{mnrgreen}\rule{\paperwidth}{1pt}}
    \begin{beamercolorbox}[
        wd=\paperwidth,
        ht=1.5em,
        dp=0.3cm,
        rightskip=0.5cm]{footer}    
    \hspace*{.5cm}    
    \vspace*{-.18cm}
    \insertpagenumber
    \hfill
    \date{\today}
    \hfill   
    \insertauthor\hfill   
    
    \end{beamercolorbox}
}

